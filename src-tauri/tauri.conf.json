{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tomo",
  "version": "0.1.1",
  "identifier": "com.tomo.section",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tomo — Section Division",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true,
        "maximized": true,
        "fullscreen": true,
        "center": true,
        "decorations": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Music",
    "shortDescription": "Shape the body. Cut the section. Hear the song.",
    "longDescription": "Tomo is a desktop music instrument. Sculpt sound bodies in a void and read their section as a track — with form, stems, capture pack, and void video export. Sessions, library, and MATCH samples stay on this machine.",
    "copyright": "Copyright © Tomo",
    "publisher": "Tomo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/Tomo.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/installer.ico",
        "uninstallerIcon": "icons/installer.ico",
        "template": "windows/installer.nsi"
      }
    }
  }
}
